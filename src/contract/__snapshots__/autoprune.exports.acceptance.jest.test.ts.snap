exports[`autoprune exports (the consumer wire-up seam) given: [case5c] the ONE way genTempDir refuses a consumer — and the one it dropped when: [t0] a consumer trips each one from the installed package then: 🔴 and the OUTCOMES a human reads are shaped as here 1`] = `
"── MINTS: a slug shaped like a run stamp ──
MINTED: <ts>._.rdeadbeef.<hex>

── REFUSES: a run id env var that is not a run id ──
BadRequestError: test-fns: TEST_FNS_RUN is set, but is not a run id

{
  "TEST_FNS_RUN": "not-a-run-id",
  "expected": "/^r[a-f0-9]{8}$/i",
  "hint": "unset TEST_FNS_RUN — the autoprune setup mints it for you at the start of each run, so a value set by hand or left over from an earlier shell will stamp temp dirs that no reclaim can read."
