exports[`autoprune exports (the consumer wire-up seam) given: [case5b] isTempDir — the export a consumer FILTERS their count through when: [t0] they call it from the installed package then: 🔴 and the GRAMMAR it admits reads as here 1`] = `
{
  "a LEGACY name, minted before the run slot existed": true,
  "a full path to a stamped dir": true,
  "a name whose hex is too short": false,
  "a name with no hex at all": false,
  "a name with no timestamp": false,
  "a slug shaped like a run id, beside an empty slot": true,
  "a stamped name, whose run slot holds an id": true,
  "an unstamped name, whose run slot holds _": true,
  "the root gitignore the infra writes": false,
  "the root readme the infra writes": false,
}
