exports[`autoprune (J1 — the clamp that bites) given: [case1] a wired run that allocates temp dirs, nested in our own when: [t0] the run completes its full setup → allocate → teardown then: 🔴 and the SHAPE of the verdict it renders is as here 1`] = `
[
  "run: string",
  "runInherited: string",
  "countMade: number",
  "countLeft: number",
  "pathPhysical: string",
]
`;

exports[`autoprune (J1 — the clamp that bites) given: [case2] a run whose tests FAILED when: [t0] the teardown fires after the failure then: and the VERDICT the child renders is shaped as here 1`] = `
